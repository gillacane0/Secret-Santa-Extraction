# Copy this file to .env and fill it in.
# .env is ignored by git, so your password never ends up on GitHub.

# The address the emails are sent from.
SMTP_USER=your.address@gmail.com

# For Gmail this is an "app password", NOT your normal password (see README).
SMTP_PASSWORD=abcdefghijklmnop

# The sender name your friends will see.
SENDER_NAME=Secret Santa

# Only change these if you don't use Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
